<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>ai.orca.jarvis</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/zsh</string>
		<string>__ORCH_ROOT__/bin/jarvis-up.sh</string>
		<string>--fg</string>
	</array>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>30</integer>
	<key>WorkingDirectory</key>
	<string>__ORCH_ROOT__</string>
	<key>StandardOutPath</key>
	<string>__STATE_DIR_ROOT__/log/ai.orca.jarvis.log</string>
	<key>StandardErrorPath</key>
	<string>__STATE_DIR_ROOT__/log/ai.orca.jarvis.log</string>
</dict>
</plist>
